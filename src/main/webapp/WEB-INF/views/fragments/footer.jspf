<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />

<footer class="site-footer-minimal" id="site-footer">
    <div class="footer-minimal-container">
        
        <!-- Brand -->
        <a href="${ctx}/" class="footer-minimal-brand" aria-label="Evently Accueil">
            <span class="footer-logo-badge" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8L12 0Z"/>
                </svg>
            </span>
            <span class="footer-logo-text">evently.</span>
        </a>

        <!-- Tagline -->
        <div class="footer-minimal-tagline">
            Find your people. Feel the moment.
        </div>

        <!-- Copyright -->
        <div class="footer-minimal-copy">
            &copy; 2026 Evently &middot; Frontend Concept
        </div>

    </div>
</footer>
